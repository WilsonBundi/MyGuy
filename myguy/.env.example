# Database
DATABASE_URL="postgresql://username:password@localhost:5432/myguy?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Twilio Verify (required for SMS phone verification during sign-up)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# LiveKit Cloud (server-side only)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Live creator purchases (configure matching consumable products in both stores
# and add the app to RevenueCat; webhook delivery is required to credit coins)
REVENUECAT_WEBHOOK_AUTHORIZATION=""

# Private live replay storage. Use an S3-compatible bucket with private access.
LIVE_REPLAY_BUCKET=""
LIVE_REPLAY_REGION="us-east-1"
LIVE_REPLAY_ACCESS_KEY=""
LIVE_REPLAY_SECRET_KEY=""
LIVE_REPLAY_ENDPOINT=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
